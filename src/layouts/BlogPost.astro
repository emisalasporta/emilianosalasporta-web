---
import BaseLayout from './BaseLayout.astro';
import VideoYouTube from '../components/VideoYouTube.astro';
import MeGusta from '../components/MeGusta.astro';
import { CATEGORIAS } from '../consts';
import { formatFecha, isoFecha, youtubeId } from '../lib/utils';

/* `slug` viene de la pagina (src/pages/blog/[...slug].astro) y sirve para
   identificar la nota en los contadores. Es opcional: si no llega, el bloque
   de "me gusta" simplemente no se dibuja. */
const { frontmatter, slug } = Astro.props;
const { title, description, date, updated, category, tags, cover, video } = frontmatter;

/* Arriba de la nota va UNA sola cosa, en este orden de prioridad:
   1) si la nota tiene video, el video (con la portada de miniatura);
   2) si no, la portada sola;
   3) si no hay ninguna de las dos, nada — y la nota se ve como siempre.

   Es a propósito que no se muestren las dos: la portada ya es la miniatura
   del video, así que ponerlas juntas sería la misma imagen dos veces.

   El campo del panel puede venir vacío ('') o con un link mal pegado, y en
   los dos casos youtubeId() devuelve null y esto sigue de largo sin romper. */
const idVideo = youtubeId(video);

/* La portada también es la imagen que aparece cuando alguien comparte el
   link por WhatsApp o en redes. Sin portada queda la de siempre. */
const imagenParaCompartir = cover || undefined;
---

<BaseLayout title={title} description={description} image={imagenParaCompartir}>
  <article class="section">
    <div class="container">
      <div class="post">
        <span class="post-hud" aria-hidden="true">Lectura //</span>
        <a href={`/categorias/${category}`} class="pill post-cat">{CATEGORIAS[category]}</a>
        <h1 class="post-title">{title}</h1>
        <p class="lead post-desc">{description}</p>
        <p class="muted post-byline">
          <time datetime={isoFecha(date)}>{formatFecha(date)}</time>
          {updated && <span> · actualizado el {formatFecha(updated)}</span>}
        </p>

        <hr class="post-rule" />

        {idVideo ? (
          <VideoYouTube id={idVideo} title={title} poster={cover || undefined} />
        ) : cover ? (
          <img class="post-cover" src={cover} alt="" decoding="async" />
        ) : null}

        <div class="prose post-body">
          <slot />
        </div>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => <a href={`/tags/${t}`} class="tag">#{t}</a>)}
          </div>
        )}

        {slug && <MeGusta id={`blog:${slug}`} />}
      </div>

      <div class="post-back">
        <a href="/blog" class="btn btn-ghost">← Volver al blog</a>
      </div>
    </div>
  </article>
</BaseLayout>

<!-- Sin estilos propios a proposito: el molde del articulo (el panel, el riel
     de neon, los anchos, el recorte de la portada) vive en src/styles/global.css,
     en la seccion ARTICULOS. Estaba duplicado aca y en recursos/[...slug].astro,
     y las dos copias ya habian empezado a separarse. Si hay que tocar el molde,
     se toca alla y cambia en todos lados. -->
