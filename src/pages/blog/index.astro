---
/* La página 1 del blog. Las siguientes viven en `pagina/[page].astro` y las
   dos dibujan el mismo componente. Por qué está partido en dos archivos en
   vez de usar el `paginate()` de Astro está explicado en src/lib/paginar.ts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListadoBlog from '../../components/ListadoBlog.astro';
import { getCollection } from 'astro:content';
import { paginar } from '../../lib/paginar';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pagina = paginar(posts, 1);
---

<BaseLayout title="Blog" description="Notas de entrenamiento, nutrición, carreras y cabeza para corredores de trail y ultra.">
  <section class="section">
    <div class="container">
      <ListadoBlog
        posts={pagina.items}
        numero={pagina.numero}
        total={pagina.total}
        cuantasEnTotal={posts.length}
      />
    </div>
  </section>
</BaseLayout>
