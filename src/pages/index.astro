---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';

const secciones = [
  {
    href: '/blog',
    titulo: 'Blog',
    texto: 'Ideas, consejos y experiencias sobre entrenamiento, nutrición, carreras y cabeza.',
    icon: 'article',
  },
  {
    href: '/herramientas',
    titulo: 'Herramientas',
    texto: 'Calculadoras de trail y ruta para estimar tus tiempos. Usalas online o descargalas para tenerlas sin internet.',
    icon: 'calculator',
  },
  {
    href: '/recursos',
    titulo: 'Recursos',
    texto: 'Planillas, guías y archivos descargables para acompañar tu entrenamiento.',
    icon: 'download',
  },
  {
    href: '/sobre-mi',
    titulo: 'Sobre mí',
    texto: 'Quién soy, cómo entreno y por qué comparto todo esto.',
    icon: 'user',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-terrain"><HeroVisual /></div>
      <div class="hero-scrim"></div>
    </div>
    <div class="container">
      <div class="hero-text">
        <p class="eyebrow">Running · Trail · Ultra</p>
        <h1 class="hero-title">Adaptarte al cambio es más fácil acompañado.</h1>
        <p class="lead hero-lead">
          Soy Emiliano Salas Porta, entrenador de deportes de resistencia especializado en trail
          running y ultradistancia, y corredor como vos. Sé lo que es estar en pleno proceso de
          cambio y necesitar que alguien te entienda y te acompañe. Armé este espacio para eso:
          compartir lo que fui aprendiendo estos años y estar al lado tuyo, con experiencia,
          herramientas y tecnología que te sirvan de verdad.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/herramientas">Ver herramientas</a>
          <a class="btn btn-ghost" href="/blog">Leer el blog</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Qué vas a encontrar</h2>
      <div class="grid">
        {secciones.map((s) => (
          <a href={s.href} class="card card-link seccion">
            <span class="seccion-icon" aria-hidden="true">
              {s.icon === 'article' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              )}
              {s.icon === 'calculator' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01"/></svg>
              )}
              {s.icon === 'download' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
              )}
              {s.icon === 'user' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
              )}
            </span>
            <h3 class="seccion-titulo">{s.titulo}</h3>
            <p class="seccion-texto muted">{s.texto}</p>
            <span class="seccion-mas">Entrar <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--border);
    display: grid;
    align-items: center;
    min-height: clamp(34rem, 76vh, 44rem);
  }
  .hero .container { position: relative; z-index: 3; }
  .hero-text { max-width: 34rem; padding-block: clamp(3.5rem, 3rem + 5vw, 7rem); }
  .hero-title { margin-top: 0.8rem; max-width: 20ch; }
  .hero-lead { margin-top: 1.4rem; font-size: 1.15rem; max-width: 34rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* Capa 0 — terreno a sangre completa, con densidad esculpida hacia la cima */
  .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero-terrain {
    position: absolute; inset: 0; z-index: 0; opacity: 0.9;
    -webkit-mask-image: radial-gradient(22% 82% at 62% 50%, #000 16%, rgba(0, 0, 0, 0.55) 52%, transparent 100%);
            mask-image: radial-gradient(22% 82% at 62% 50%, #000 16%, rgba(0, 0, 0, 0.55) 52%, transparent 100%);
  }
  /* Capa 1 — scrims (lectura izq. + viñeta vertical + veladura pareja) */
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(90deg, #0a0b10 0%, #0a0b10 52%, rgba(10, 11, 16, 0) 72%),
      linear-gradient(180deg, rgba(10, 11, 16, 0.55) 0%, transparent 20%, transparent 74%, rgba(10, 11, 16, 0.70) 100%);
  }

  /* Mobile: identidad sin robar legibilidad → texto puro sobre el fondo */
  @media (max-width: 760px) {
    .hero { min-height: auto; display: block; }
    .hero-bg { display: none; }
    .hero-text { max-width: none; padding-block: clamp(3rem, 2.5rem + 6vw, 5rem); }
  }

  .section-title { margin-bottom: 1.75rem; }

  .seccion { display: flex; flex-direction: column; align-items: flex-start; }
  .seccion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 44px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .seccion-icon svg { width: 24px; height: 24px; }
  .seccion-titulo { margin-bottom: 0.4rem; }
  .seccion-texto { font-size: 0.96rem; flex: 1; }
  .seccion-mas {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
</style>
