---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HERRAMIENTAS, CATEGORIAS_HERRAMIENTAS } from '../../tools/registry';

export function getStaticPaths() {
  return HERRAMIENTAS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;

/* Leemos el archivo real en build: el tamaño que mostramos es el que se baja
   de verdad, y el hash sirve de cache-buster (Astro no versiona public/). */
const bytes = readFileSync(tool.file);
const pesoKB = Math.round(bytes.byteLength / 1024);
const hash = createHash('sha256').update(bytes).digest('hex').slice(0, 8);

const src = `/tools/${tool.slug}.html`;
const hrefDescarga = `${src}?v=${hash}`;
---

{/* El `summary` (una línea) va de meta description y la `description` (larga) de
    texto de la página: Google corta la meta en ~160 caracteres, y la larga
    quedaba truncada a la mitad de una frase en los resultados. */}
<BaseLayout title={tool.title} description={tool.summary}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{CATEGORIAS_HERRAMIENTAS[tool.category]}</p>
      <h1>{tool.title}</h1>
      <p class="lead tool-desc">{tool.description}</p>

      <div class="tool-actions">
        <a class="btn btn-ghost" href={hrefDescarga} download={`${tool.slug}.html`}>
          Descargar para usar sin internet (HTML, {pesoKB} KB)
        </a>
        <p class="muted tool-note">
          Es un solo archivo: bajalo, abrilo con cualquier navegador y funciona igual, sin conexión.
        </p>
      </div>
    </div>
  </section>

  <section class="tool-frame-section">
    <div class="container">
      <iframe
        id="tool-frame"
        src={src}
        title={tool.title}
        scrolling="no"
      ></iframe>
      <noscript>
        <p class="muted">
          La calculadora necesita JavaScript. También podés <a href={hrefDescarga} download={`${tool.slug}.html`}>descargarla</a> y abrirla en tu navegador.
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script>
  /* Auto-alto del iframe: la calculadora avisa cuánto mide y le sacamos el
     scroll propio (nada de doble barra). Sólo aceptamos mensajes de nuestro
     mismo origen Y del iframe que pusimos nosotros. */
  const frame = document.getElementById('tool-frame') as HTMLIFrameElement | null;

  if (frame) {
    /* Le pedimos el alto en cuanto estamos listos. Sin esto hay una carrera:
       la herramienta avisa su alto al cargar, y si eso pasa antes de que
       enganchemos el listener de acá abajo, ese primer aviso se pierde. */
    const pedirAlto = () => {
      frame.contentWindow?.postMessage({ tipo: 'pedir-alto' }, window.location.origin);
    };
    frame.addEventListener('load', pedirAlto);
    pedirAlto(); // por si el iframe ya había cargado antes que este script

    window.addEventListener('message', (e: MessageEvent) => {
      if (e.origin !== window.location.origin) return;
      if (e.source !== frame.contentWindow) return;

      const data = e.data;
      if (!data || data.tipo !== 'alto-herramienta') return;

      const alto = Number(data.alto);
      if (!Number.isFinite(alto) || alto <= 0) return;

      frame.style.height = `${Math.ceil(alto)}px`;
    });
  }
</script>

<style>
  .tool-desc { max-width: 46rem; margin-top: 0.5rem; }

  .tool-actions { margin-top: 1.75rem; }
  .tool-note { font-size: 0.88rem; margin-top: 0.6rem; max-width: 40rem; }

  .tool-frame-section { padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem); }

  #tool-frame {
    display: block;
    width: 100%;
    /* Alto inicial cercano al real para que no pegue el salto mientras carga:
       apenas arranca, la herramienta avisa cuánto mide y lo ajustamos. */
    height: 1120px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color-scheme: dark;
  }

  @media (max-width: 40rem) {
    #tool-frame { height: 1600px; }
  }
</style>
