---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HERRAMIENTAS, CATEGORIAS_HERRAMIENTAS } from '../../tools/registry';

export function getStaticPaths() {
  return HERRAMIENTAS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;

/* Leemos el archivo real en build: el tamaño que mostramos es el que se baja
   de verdad, y el hash sirve de cache-buster (Astro no versiona public/). */
const bytes = readFileSync(tool.file);
const pesoKB = Math.round(bytes.byteLength / 1024);
const hash = createHash('sha256').update(bytes).digest('hex').slice(0, 8);

/* La versión sale del propio archivo, del mismo `VERSION` que la calculadora
   escribe en su pie. Existe porque estas herramientas SE DESCARGAN: el sello
   del pie le dice al que tiene una copia guardada cuál tiene, pero sin esto no
   había contra qué compararlo — tenía que bajarla de nuevo para enterarse de si
   había cambiado. Se lee acá en el build y no se duplica a mano en ningún lado,
   así que no se puede desincronizar. Si algún día el patrón no coincide, la
   línea simplemente no se muestra: nunca hace fallar el build. */
const mVer = bytes
  .toString('utf8')
  .match(/(?:var|const|let)\s+VERSION\s*=\s*\{\s*n\s*:\s*["']([^"']+)["']\s*,\s*fecha\s*:\s*["']([^"']+)["']/);
const version = mVer ? { n: mVer[1], fecha: mVer[2] } : null;

/* El hash va en la URL del iframe, no sólo en la de descarga: así el servidor
   puede cachear la calculadora por mucho tiempo (son 100-200 KB) y aún así,
   cuando subimos una versión nueva, cambia la URL y el navegador la baja sola.
   Antes la herramienta se bajaba entera en cada visita. */
const src = `/tools/${tool.slug}.html?v=${hash}`;
const hrefDescarga = src;

/* La descripción del registro puede venir en varios párrafos (separados por una
   línea en blanco). Los partimos acá para que se lean como texto y no como un
   ladrillo. Escapamos el HTML: el texto es nuestro, pero no hay razón para
   dejar una puerta abierta. */
const escapar = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const descripcionHtml = tool.description
  .split(/\n\s*\n/)
  .map((p) => `<p>${escapar(p.trim())}</p>`)
  .join('');
---

{/* El `summary` (una línea) va de meta description y la `description` (larga) de
    texto de la página: Google corta la meta en ~160 caracteres, y la larga
    quedaba truncada a la mitad de una frase en los resultados. */}
<BaseLayout title={tool.title} description={tool.summary}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{CATEGORIAS_HERRAMIENTAS[tool.category]}</p>
      <h1>{tool.title}</h1>

      {/* El texto usa el ancho completo de la columna y la descarga va como un
          enlace al pie del párrafo, no como un botón al costado: acá el que
          manda es lo que explica de qué se trata. */}
      <div class="tool-intro">
        <div class="lead tool-desc" set:html={descripcionHtml} />

        <p class="tool-descarga">
          <a href={hrefDescarga} download={`${tool.slug}.html`}>
            Descargar para usar sin internet (HTML, {pesoKB} KB)
          </a>
          <span class="muted tool-note">
            Es un solo archivo: bajalo, abrilo con cualquier navegador y funciona igual, sin conexión.
            {version && (
              <>
                {' '}Ésta es la <b>versión {version.n}</b>, del {version.fecha}. Si ya tenías una
                copia, mirá abajo de todo qué versión dice: si es otra, bajala de nuevo.
              </>
            )}
          </span>
        </p>
      </div>
    </div>
  </section>

  <section class="tool-frame-section">
    <div class="container">
      {/* Sin `scrolling="no"`: si por lo que sea no llega el aviso de alto (una
          conexión lenta en el celular, por ejemplo), la calculadora se queda
          con su propia barra y se puede usar igual. Cortada y sin salida es
          peor que una barra de más durante medio segundo. Cuando el alto llega
          es exacto, así que no sobra nada que scrollear y la barra no aparece. */}
      <iframe
        id="tool-frame"
        src={src}
        title={tool.title}
      ></iframe>
      <noscript>
        <p class="muted">
          La calculadora necesita JavaScript. También podés <a href={hrefDescarga} download={`${tool.slug}.html`}>descargarla</a> y abrirla en tu navegador.
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script>
  /* Auto-alto del iframe: la calculadora avisa cuánto mide y le sacamos el
     scroll propio (nada de doble barra). Sólo aceptamos mensajes de nuestro
     mismo origen Y del iframe que pusimos nosotros. */
  const frame = document.getElementById('tool-frame') as HTMLIFrameElement | null;

  if (frame) {
    /* Le pedimos el alto en cuanto estamos listos. Sin esto hay una carrera:
       la herramienta avisa su alto al cargar, y si eso pasa antes de que
       enganchemos el listener de acá abajo, ese primer aviso se pierde. */
    const pedirAlto = () => {
      frame.contentWindow?.postMessage({ tipo: 'pedir-alto' }, window.location.origin);
    };
    frame.addEventListener('load', pedirAlto);
    pedirAlto(); // por si el iframe ya había cargado antes que este script

    window.addEventListener('message', (e: MessageEvent) => {
      if (e.origin !== window.location.origin) return;
      if (e.source !== frame.contentWindow) return;

      const data = e.data;
      if (!data || data.tipo !== 'alto-herramienta') return;

      const alto = Number(data.alto);
      if (!Number.isFinite(alto) || alto <= 0) return;

      frame.style.height = `${Math.ceil(alto)}px`;
    });

    /* Al girar el teléfono cambia el ancho y con él el alto real de la
       calculadora. El ResizeObserver de adentro suele avisar solo, pero si el
       navegador lo agrupa con el repintado del giro el aviso se pierde y queda
       un hueco (o contenido cortado). Volvemos a preguntar, por las dudas. */
    let pendiente: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(pendiente);
      pendiente = setTimeout(pedirAlto, 200);
    });
  }
</script>

<style>
  /* Antes esta pagina era mas ancha que el resto (82rem) para que la
     calculadora entrara justa. Se saco: un sitio con tres anchos distintos se
     siente como tres sitios. Ahora usa el ancho de siempre, --content, igual
     que la home y que todo lo demas. La calculadora es responsiva por dentro
     (sus cortes estan en 880 y 680 px), asi que a 1048 px conserva todas sus
     columnas y no pierde nada. */

  .tool-intro { margin-top: 0.75rem; }
  .tool-desc :global(p + p) { margin-top: 0.9rem; }

  .tool-descarga {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-size: 0.9rem;
  }
  .tool-descarga a { font-weight: 500; }
  .tool-note { font-size: 0.88rem; }

  .tool-frame-section { padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem); }

  #tool-frame {
    display: block;
    width: 100%;
    /* Alto inicial cercano al real para que no pegue el salto mientras carga:
       apenas arranca, la herramienta avisa cuánto mide y lo ajustamos. */
    height: 1120px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color-scheme: dark;
  }

  @media (max-width: 40rem) {
    #tool-frame { height: 1600px; }
  }
</style>
