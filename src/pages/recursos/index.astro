---
/* La página 1 de los recursos. Mismo molde que /blog: el cuerpo del listado
   está en un componente compartido y las páginas 2 en adelante viven en
   `pagina/[page].astro`. Ver src/lib/paginar.ts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListadoRecursos from '../../components/ListadoRecursos.astro';
import { getCollection } from 'astro:content';
import { paginar } from '../../lib/paginar';

const recursos = (
  await getCollection('recursos', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pagina = paginar(recursos, 1);
---

<BaseLayout
  title="Recursos"
  description="Planillas, guías y archivos descargables para acompañar tu entrenamiento de trail y ultradistancia. Gratis y sin dejar el mail."
>
  <section class="section">
    <div class="container">
      <ListadoRecursos recursos={pagina.items} numero={pagina.numero} total={pagina.total} />
    </div>
  </section>
</BaseLayout>
