---
import { existsSync, readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TIPOS_RECURSOS } from '../../consts';
import { formatFecha, isoFecha } from '../../lib/utils';
import MeGusta from '../../components/MeGusta.astro';

export async function getStaticPaths() {
  const recursos = await getCollection('recursos', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return recursos.map((recurso) => ({
    params: { slug: recurso.id },
    props: { recurso },
  }));
}

const { recurso } = Astro.props;
const { title, description, date, tipo, archivo, tags } = recurso.data;
const { Content } = await render(recurso);

/* Igual que en /herramientas: leemos el archivo real en build, así el peso que
   mostramos es el que se baja de verdad y el hash sirve de cache-buster (Astro
   no versiona lo que vive en public/).
   El `archivo` es opcional y lo carga Emiliano desde el panel, así que puede no
   estar o apuntar a una ruta que ya no existe: si no lo encontramos, mostramos
   la ficha sin botón en vez de romper el build entero. */
let descarga = null;
if (archivo) {
  const ruta = `public${archivo}`;
  if (existsSync(ruta)) {
    const bytes = readFileSync(ruta);
    /* Piso de 1 KB: un archivo chico redondeaba a "0 KB", que se lee como que
       está roto. Ningún archivo pesa cero. */
    const kb = Math.max(1, Math.round(bytes.byteLength / 1024));
    descarga = {
      href: `${archivo}?v=${createHash('sha256').update(bytes).digest('hex').slice(0, 8)}`,
      peso: kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${kb} KB`,
      nombre: archivo.split('/').pop(),
      ext: (archivo.split('.').pop() || '').toUpperCase(),
    };
  } else {
    console.warn(
      `[recursos] "${title}" apunta a ${archivo} y ese archivo no está en public/. ` +
        `La ficha se publica sin botón de descarga.`
    );
  }
}
---

<BaseLayout title={title} description={description}>
  <article class="section">
    <div class="container">
      <div class="post">
        <span class="post-hud" aria-hidden="true">Lectura //</span>
        <p class="eyebrow">{TIPOS_RECURSOS[tipo]}</p>
        <h1 class="post-title">{title}</h1>
        <p class="lead post-desc">{description}</p>
        <p class="muted post-byline">
          <time datetime={isoFecha(date)}>{formatFecha(date)}</time>
        </p>

        {descarga && (
          <div class="descarga">
            <a
              class="btn btn-primary"
              href={descarga.href}
              download={descarga.nombre}
              data-contar={`recurso:${recurso.id}`}
            >
              Descargar ({descarga.ext}, {descarga.peso})
            </a>
            <p class="muted descarga-nota">Es tuyo: bajalo y usalo cuando quieras.</p>
          </div>
        )}

        <hr class="post-rule" />

        <div class="prose post-body">
          <Content />
        </div>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => <a href={`/tags/${t}`} class="tag">#{t}</a>)}
          </div>
        )}

        <MeGusta id={`recurso:${recurso.id}`} mostrarDescargas />

        {/* Mismo bloque que al final de una nota (los estilos están en
            global.css). Acá importa todavía más: el que se bajó una planilla y
            no la entiende no tenía hasta ahora ninguna forma de avisar. */}
        <aside class="preguntar">
          <p class="preguntar-titulo">¿Te sirvió? ¿Algo no se entiende?</p>
          <p class="muted preguntar-texto">
            Contame qué te pareció o qué le falta. Estos materiales los voy corrigiendo con lo
            que me llega.
          </p>
          <a class="btn btn-ghost" href={`/contacto?sobre=${encodeURIComponent(title)}`}>
            Escribirme sobre este recurso →
          </a>
        </aside>
      </div>

      <div class="post-back">
        <a href="/recursos" class="btn btn-ghost">← Volver a recursos</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* El molde del articulo (panel, riel, anchos) vive en global.css, seccion
     ARTICULOS. Aca queda SOLO lo propio de un recurso: el boton de descarga. */

  /* El boton va arriba, antes del texto: el que llega a esta pagina ya sabe lo
     que quiere. Las notas son para el que necesita leer antes de bajar. */
  .descarga { margin-top: 1.75rem; }
  .descarga-nota { font-size: 0.88rem; margin-top: 0.6rem; }
</style>

<script>
  /* Contar las descargas sin molestar a nadie.

     El enlace sigue apuntando al PDF de siempre --no lo pasamos por ningun
     intermediario-- asi que la direccion del archivo no cambia, Google la
     sigue viendo igual, y si esto falla la descarga arranca lo mismo.

     `sendBeacon` es justo para esto: el navegador se lleva el aviso en
     segundo plano y no le importa si la pagina se va mientras tanto. Con un
     `fetch` normal, el navegador puede cancelarlo al empezar la bajada y la
     descarga no se contaria. */
  document.querySelectorAll<HTMLAnchorElement>('a[data-contar]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      const id = enlace.dataset.contar;
      if (!id || !navigator.sendBeacon) return;
      try {
        navigator.sendBeacon('/api/descarga', JSON.stringify({ id }));
      } catch {
        /* que no se cuente jamas puede estorbar la descarga */
      }
    });
  });
</script>
