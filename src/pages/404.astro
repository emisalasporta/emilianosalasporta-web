---
import BaseLayout from '../layouts/BaseLayout.astro';

/* Mismo molde que el resto del sitio: eyebrow, h1, lead. Nada de dibujitos ni
   de "oops!": el que cae acá quiere irse a otro lado rápido, así que lo que
   importa son las puertas de salida. */
---

<BaseLayout
  title="Página no encontrada"
  description="Esta página no existe o cambió de dirección."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="lead error-lead">
        Puede que el enlace esté viejo, que la haya movido, o que se te haya escapado una letra
        en la dirección. No te preocupes, no rompiste nada.
      </p>

      <div class="error-salidas">
        <a href="/" class="btn btn-primary">Ir al inicio</a>
        <a href="/blog" class="btn btn-ghost">Ver el blog</a>
        <a href="/herramientas" class="btn btn-ghost">Ver las calculadoras</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-lead { max-width: 42rem; margin-top: 0.5rem; }
  .error-salidas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
