---
/* Mapa topográfico generado en build: relieve sintético (varias cimas)
   del que se extraen curvas de nivel con "marching squares". Curvas
   orgánicas como un mapa real, sin texto. Puramente decorativo. */

const W = 600, H = 640;
const cols = 72, rows = 78;
const dx = W / (cols - 1), dy = H / (rows - 1);
const f = (x) => Math.round(x * 10) / 10;

function bump(u, v, cu, cv, amp, sig) {
  const d = (u - cu) ** 2 + (v - cv) ** 2;
  return amp * Math.exp(-d / (2 * sig * sig));
}
function field(u, v) {
  let h =
    bump(u, v, 0.34, 0.36, 1.00, 0.15) +
    bump(u, v, 0.64, 0.29, 0.94, 0.14) +
    bump(u, v, 0.50, 0.66, 1.00, 0.16) +
    bump(u, v, 0.80, 0.60, 0.88, 0.13) +
    bump(u, v, 0.22, 0.60, 0.64, 0.12) +
    bump(u, v, 0.60, 0.88, 0.74, 0.14);
  h += 0.10 * Math.sin(6.2 * u + 0.7) * Math.cos(5.3 * v - 0.4);
  h += 0.07 * Math.sin(9.1 * v + 1.9) * Math.cos(7.7 * u + 0.3);
  return h;
}
const V = [];
let maxH = -Infinity, minH = Infinity, maxI = 0, maxJ = 0;
for (let j = 0; j < rows; j++) {
  V[j] = [];
  for (let i = 0; i < cols; i++) {
    const h = field(i / (cols - 1), j / (rows - 1));
    V[j][i] = h;
    if (h > maxH) { maxH = h; maxI = i; maxJ = j; }
    if (h < minH) minH = h;
  }
}
for (let j = 0; j < rows; j++) for (let i = 0; i < cols; i++) V[j][i] = (V[j][i] - minH) / (maxH - minH);

const CASES = {
  1: [['L', 'B']], 2: [['B', 'R']], 3: [['L', 'R']], 4: [['T', 'R']],
  5: [['T', 'R'], ['B', 'L']], 6: [['T', 'B']], 7: [['T', 'L']], 8: [['T', 'L']],
  9: [['T', 'B']], 10: [['T', 'L'], ['B', 'R']], 11: [['T', 'R']], 12: [['L', 'R']],
  13: [['B', 'R']], 14: [['L', 'B']],
};
function edgePoint(edge, i, j, T) {
  const tl = V[j][i], tr = V[j][i + 1], br = V[j + 1][i + 1], bl = V[j + 1][i];
  if (edge === 'T') { const t = (T - tl) / (tr - tl); return { id: 'h' + i + '_' + j, p: [i * dx + dx * t, j * dy] }; }
  if (edge === 'B') { const t = (T - bl) / (br - bl); return { id: 'h' + i + '_' + (j + 1), p: [i * dx + dx * t, (j + 1) * dy] }; }
  if (edge === 'L') { const t = (T - tl) / (bl - tl); return { id: 'v' + i + '_' + j, p: [i * dx, j * dy + dy * t] }; }
  const t = (T - tr) / (br - tr); return { id: 'v' + (i + 1) + '_' + j, p: [(i + 1) * dx, j * dy + dy * t] };
}
function isolines(T) {
  const pts = {}, links = {}, segs = [];
  const add = (A, B) => {
    pts[A.id] = A.p; pts[B.id] = B.p;
    const k = segs.length; segs.push([A.id, B.id]);
    (links[A.id] = links[A.id] || []).push(k);
    (links[B.id] = links[B.id] || []).push(k);
  };
  for (let j = 0; j < rows - 1; j++) for (let i = 0; i < cols - 1; i++) {
    const c = (V[j][i] >= T ? 8 : 0) + (V[j][i + 1] >= T ? 4 : 0) + (V[j + 1][i + 1] >= T ? 2 : 0) + (V[j + 1][i] >= T ? 1 : 0);
    const segments = CASES[c];
    if (!segments) continue;
    for (const [e1, e2] of segments) add(edgePoint(e1, i, j, T), edgePoint(e2, i, j, T));
  }
  const used = new Array(segs.length).fill(false);
  const other = (si, node) => segs[si][0] === node ? segs[si][1] : segs[si][0];
  const nextSeg = (node, from) => (links[node] || []).find((si) => !used[si] && si !== from);
  const lines = [];
  for (let s = 0; s < segs.length; s++) {
    if (used[s]) continue;
    used[s] = true;
    const line = [pts[segs[s][0]], pts[segs[s][1]]];
    let node = segs[s][1], from = s, ns;
    while ((ns = nextSeg(node, from)) !== undefined) { used[ns] = true; const o = other(ns, node); line.push(pts[o]); from = ns; node = o; if (node === segs[s][0]) break; }
    node = segs[s][0]; from = s;
    while ((ns = nextSeg(node, from)) !== undefined) { used[ns] = true; const o = other(ns, node); line.unshift(pts[o]); from = ns; node = o; }
    lines.push(line);
  }
  return lines;
}
function toPath(line) {
  const closed = line.length > 3 && Math.hypot(line[0][0] - line[line.length - 1][0], line[0][1] - line[line.length - 1][1]) < 0.5;
  const p = closed ? line.slice(0, -1) : line;
  const n = p.length;
  if (n < 2) return '';
  const P = (i) => closed ? p[(i + n) % n] : p[Math.max(0, Math.min(n - 1, i))];
  let d = `M ${f(p[0][0])} ${f(p[0][1])}`;
  const end = closed ? n : n - 1;
  for (let i = 0; i < end; i++) {
    const p0 = P(i - 1), p1 = P(i), p2 = P(i + 1), p3 = P(i + 2);
    d += ` C ${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d + (closed ? ' Z' : '');
}

const NLEV = 14;
const paths = [];
const loops = [];
for (let li = 1; li < NLEV; li++) {
  const T = li / NLEV;
  const t = (li - 1) / (NLEV - 2);
  const index = li % 4 === 0;
  const stroke = index ? '#74d6ff' : '#2fb8ff';
  const width = index ? 1.9 : 1.05;
  const opacity = +(0.24 + t * 0.52).toFixed(2);
  for (const line of isolines(T)) {
    const d = toPath(line);
    if (!d) continue;
    const idx = paths.push({ d, stroke, width, opacity }) - 1;
    const isClosed = line.length > 8 && Math.hypot(line[0][0] - line[line.length - 1][0], line[0][1] - line[line.length - 1][1]) < 0.5;
    if (isClosed) {
      let sx = 0, sy = 0;
      for (const p of line) { sx += p[0]; sy += p[1]; }
      loops.push({ line, idx, cx: sx / line.length, cy: sy / line.length, style: { stroke, width, opacity } });
    }
  }
}
const peakX = maxI * dx, peakY = maxJ * dy;

// Detalle oculto: la cota "2509 m" (25/09) inserta en una curva de una cima,
// con la línea cortada para que el número forme parte de ella (estilo mapa real).
let cota = null;
{
  const bboxOf = (line) => {
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const p of line) { if (p[0] < x0) x0 = p[0]; if (p[0] > x1) x1 = p[0]; if (p[1] < y0) y0 = p[1]; if (p[1] > y1) y1 = p[1]; }
    return (x1 - x0) * (y1 - y0);
  };
  const cand = loops.filter((l) => l.cx >= 300 && l.cx <= 470 && l.cy >= 200 && l.cy <= 520);
  cand.forEach((l) => { l.area = bboxOf(l.line); });
  cand.sort((a, b) => a.area - b.area);
  const target = cand.find((l) => l.area > 1400) || cand[0];
  if (target) {
    const pts = target.line.slice(0, -1);
    const n = pts.length;
    let k = -1, bestScore = Infinity;
    for (let i = 0; i < n; i++) {
      if (pts[i][0] < target.cx) continue;
      const pa = pts[(i - 1 + n) % n], pb = pts[(i + 1) % n];
      const a = Math.atan2(pb[1] - pa[1], pb[0] - pa[0]);
      const score = Math.abs(Math.sin(a)) - (pts[i][0] / 600) * 0.12;
      if (score < bestScore) { bestScore = score; k = i; }
    }
    if (k < 0) k = 0;
    const pa = pts[(k - 1 + n) % n], pb = pts[(k + 1) % n];
    let ang = Math.atan2(pb[1] - pa[1], pb[0] - pa[0]) * 180 / Math.PI;
    if (ang > 90) ang -= 180; else if (ang < -90) ang += 180;
    const bx = pts[k][0], by = pts[k][1];
    const gapHalf = 24;
    const dist = (i) => Math.hypot(pts[i][0] - bx, pts[i][1] - by);
    let fwd = k, g1 = 0; while (dist((fwd + 1) % n) < gapHalf && g1++ < n) fwd = (fwd + 1) % n;
    let bwd = k, g2 = 0; while (dist((bwd - 1 + n) % n) < gapHalf && g2++ < n) bwd = (bwd - 1 + n) % n;
    const start = (fwd + 1) % n, end = (bwd - 1 + n) % n;
    const openPts = [];
    for (let i = start, g = 0; g <= n; i = (i + 1) % n, g++) { openPts.push(pts[i]); if (i === end) break; }
    paths.splice(target.idx, 1);
    if (openPts.length > 1) paths.push({ d: toPath(openPts), ...target.style });
    cota = { x: +bx.toFixed(1), y: +by.toFixed(1), angle: +ang.toFixed(1) };
  }
}
---
<div class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 600 640" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="peakglow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#2fb8ff" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#2fb8ff" stop-opacity="0" />
      </radialGradient>
    </defs>
    <ellipse cx={peakX} cy={peakY} rx="230" ry="210" fill="url(#peakglow)" />
    <g class="contours">
      {paths.map((s) => (
        <path d={s.d} fill="none" stroke={s.stroke} stroke-width={s.width} opacity={s.opacity} stroke-linejoin="round" stroke-linecap="round" />
      ))}
    </g>
    {cota && (
      <text class="cota" x={cota.x} y={cota.y} transform={`rotate(${cota.angle} ${cota.x} ${cota.y})`} text-anchor="middle" dominant-baseline="middle">2509 m</text>
    )}
  </svg>
</div>

<style>
  .hero-visual { position: absolute; inset: 0; }
  .hero-visual svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .cota { font-family: var(--font-mono); fill: #ff2e9a; font-size: 7.7px; letter-spacing: 0.3px; }

  @media (prefers-reduced-motion: no-preference) {
    .contours { opacity: 0; animation: revelar 1.7s ease-out 0.15s forwards; }
  }
  @keyframes revelar { to { opacity: 1; } }
</style>
