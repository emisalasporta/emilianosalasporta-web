---
import { CATEGORIAS } from '../consts';
import { formatFecha, isoFecha } from '../lib/utils';

const { post } = Astro.props;
const { title, description, date, category, tags, cover } = post.data;
---

<a href={`/blog/${post.id}`} class="card card-link post-card">
  {cover && <img class="post-card-cover" src={cover} alt="" loading="lazy" decoding="async" />}
  <div class="post-card-meta">
    <span class="pill">{CATEGORIAS[category]}</span>
    <time datetime={isoFecha(date)} class="muted post-card-date">{formatFecha(date)}</time>
  </div>
  <h3 class="post-card-title">{title}</h3>
  <p class="muted post-card-desc">{description}</p>
  {tags.length > 0 && (
    <div class="post-card-tags">
      {tags.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
    </div>
  )}
</a>

<style>
  .post-card { display: flex; flex-direction: column; }
  /* La portada va a sangre, pegada a los bordes de la tarjeta: por eso el
     ancho se estira los 1.5rem de padding de cada lado y el margen es
     negativo. Sin `max-width: none` la regla global de las imágenes la
     recortaría al 100% y quedaría corrida.
     Las notas sin portada no muestran nada y se ven como siempre. */
  .post-card-cover {
    max-width: none;
    width: calc(100% + 3rem);
    margin: -1.5rem -1.5rem 1.25rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
    border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0 0;
  }
  .post-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .post-card-date { font-family: var(--font-mono); font-size: 0.78rem; }
  .post-card-title { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .post-card-desc { font-size: 0.95rem; flex: 1; }
  .post-card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
</style>
